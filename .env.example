# ── SolBorn environment variables ────────────────────────────────────────────
# Copy to .env.local for local dev. Add the same keys to Vercel project
# settings → Environment Variables for production.

# ── AI providers ─────────────────────────────────────────────────────────────
# Groq powers the agent chat (free tier ~14k req/day).
GROQ_API_KEY=

# Optional fallback / embeddings providers.
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# ── Solana ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_HELIUS_RPC=

# Mainnet RPC for paid landing-generator payment verification + sending.
# Required for the /api/landing/generate flow (0.05 SOL payment check).
# Without it the app falls back to clusterApiUrl('mainnet-beta'), which is
# rate-limited; fine for dev/preview, get a Helius mainnet endpoint for prod.
NEXT_PUBLIC_HELIUS_RPC_MAINNET=

# Bubblegum cNFT tree address (created via scripts/create-tree.mjs).
NEXT_PUBLIC_BUBBLEGUM_TREE=

# Server-side faucet keypair for /api/faucet (devnet only).
FAUCET_PRIVATE_KEY=

# ── Privy embedded wallet (optional, for email sign-in) ──────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=

# ── Upstash Vector — agent semantic memory ───────────────────────────────────
# Create at console.upstash.com/vector
# Index name: solborn-memory | Dimensions: 1024 | Metric: Cosine
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# ── Upstash Redis — subdomain mirrors for *.solborn.xyz ──────────────────────
# Create a separate Redis database at console.upstash.com/redis
# Region: fra1 (Frankfurt) recommended for EU + RU
# Used by /api/subdomain/{claim,sync} + middleware to host public read-only
# product pages at <slug>.solborn.xyz. Without these vars the subdomain
# feature degrades gracefully — apex domain keeps working as before.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Telegram notifications (optional, for feedback + interest forms) ─────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google Safe Browsing — required for customize-launch-page feature ────────
# When users set their product URL via the Edit modal, the URL is checked
# against Google Safe Browsing before being saved. Without this key,
# /api/scam-check returns { safe: false, error: 'check-disabled' } and all
# product URL edits are blocked.
#
# Get a key:
#   1. Open https://console.cloud.google.com/
#   2. Create or select a project
#   3. APIs & Services → Library → enable "Safe Browsing API"
#   4. APIs & Services → Credentials → Create credentials → API key
#   5. Restrict the key to "Safe Browsing API" only
# Free quota: ~10k req/day. We cache safe results 1h per URL.
GOOGLE_SAFE_BROWSING_API_KEY=

# ── Site metadata ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.solborn.xyz
